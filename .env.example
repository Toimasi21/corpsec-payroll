# =============================================================================
# CorpSec HR Payroll — Environment Configuration Template
# =============================================================================

# Application Environment (development, test, production)
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_NAME="CorpSec HR Payroll"
NEXT_PUBLIC_COMPANY_NAME="CorpSec Investigations & Guarding Services"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (SQLite by default for zero-setup, PostgreSQL ready)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL connection string for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/corpsec_payroll?schema=public"

# Authentication & Session Security
JWT_SECRET="corpsec-hr-payroll-secret-key-change-this-in-production-2026"
JWT_EXPIRES_IN="8h"
SESSION_COOKIE_NAME="corpsec_session"

# File & Document Storage Configuration (Phase 1 Foundation)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads/documents"
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# External Integrations (Prepared for Future Phases)
# Email SMTP Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CorpSec HR <no-reply@corpsec.co.ke>"

# SMS Gateway (Future Phase)
SMS_API_KEY=""
SMS_PARTNER_ID=""
SMS_SENDER_ID="CORPSEC"

# M-Pesa B2C Integration (Future Phase — Phase 10)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
